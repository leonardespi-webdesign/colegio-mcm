---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="es" path="/404" title="Página no encontrada">
  <section class="section-padding">
    <div class="container-base text-center">
      <p class="font-heading text-2xl text-neutral-400">404</p>
      <h1 class="mt-2 font-heading text-3xl font-bold text-primary">Página no encontrada</h1>
      <p class="mt-4 text-neutral-600">
        La página que buscas no existe o cambió de dirección.
      </p>
      <a href="/" class="btn-primary mt-8 inline-block">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
