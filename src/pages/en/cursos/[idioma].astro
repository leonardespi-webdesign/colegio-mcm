---
import CursoDetalle from '../../../components/pages/CursoDetalle.astro';
import { getContent } from '../../../i18n/content';

export function getStaticPaths() {
  const { idiomas } = getContent('en');
  return idiomas.map((idioma) => ({ params: { idioma: idioma.slug } }));
}

const { idioma } = Astro.params;
---

<CursoDetalle lang="en" slug={idioma} />
