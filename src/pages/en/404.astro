---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" path="/404" title="Page not found">
  <section class="section-padding">
    <div class="container-base text-center">
      <p class="font-heading text-2xl text-neutral-400">404</p>
      <h1 class="mt-2 font-heading text-3xl font-bold text-primary">Page not found</h1>
      <p class="mt-4 text-neutral-600">
        The page you're looking for doesn't exist or moved.
      </p>
      <a href="/en" class="btn-primary mt-8 inline-block">Back to home</a>
    </div>
  </section>
</BaseLayout>
