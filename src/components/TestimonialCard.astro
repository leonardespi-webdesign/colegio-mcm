---
interface Props {
  nombre: string;
  rol: string;
  texto: string;
  imagen: string;
}

const { nombre, rol, texto, imagen } = Astro.props;
---

<figure class="rounded-2xl bg-white p-6 shadow-[0_2px_10px_-4px_rgba(30,58,95,0.15)] transition-shadow hover:shadow-[0_16px_32px_-16px_rgba(30,58,95,0.35)]">
  <blockquote class="text-neutral-700">&ldquo;{texto}&rdquo;</blockquote>
  <figcaption class="mt-4 flex items-center gap-3">
    <img src={imagen} alt={nombre} class="h-10 w-10 rounded-full object-cover" loading="lazy" />
    <div>
      <p class="font-semibold text-neutral-900">{nombre}</p>
      <p class="text-sm text-neutral-500">{rol}</p>
    </div>
  </figcaption>
</figure>
