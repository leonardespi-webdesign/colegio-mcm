---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  texto: string;
  subtitulo?: string;
  ctaTexto: string;
  href: string;
}

const { lang, texto, subtitulo, ctaTexto, href } = Astro.props;
---

<section class="section-padding bg-primary text-white">
  <div class="container-base text-center">
    <h2 class="font-heading text-2xl md:text-3xl font-bold">{texto}</h2>
    {subtitulo && <p class="mt-3 text-white/80">{subtitulo}</p>}
    <a href={getRelativeLocaleUrl(lang, href)} class="btn-secondary mt-6 inline-block">{ctaTexto}</a>
  </div>
</section>
