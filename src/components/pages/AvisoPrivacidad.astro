---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent, type Lang } from '../../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { aviso_privacidad: a } = getContent(lang);
---

<BaseLayout lang={lang} path="/aviso-de-privacidad" title={a.titulo}>
  <section class="section-padding">
    <div class="container-base max-w-3xl prose">
      <h1 class="font-heading text-3xl font-bold text-primary">{a.titulo}</h1>
      <p class="text-sm text-neutral-500">{lang === 'es' ? 'Última actualización' : 'Last updated'}: {a.fecha_actualizacion}</p>

      <p class="mt-6">{a.intro}</p>

      <h2 class="mt-8 font-heading text-xl font-semibold text-primary">{a.responsable_titulo}</h2>
      <p>{a.responsable_texto}</p>

      <h2 class="mt-8 font-heading text-xl font-semibold text-primary">{a.datos_titulo}</h2>
      <ul>
        {a.datos_items.map((item) => <li>{item}</li>)}
      </ul>

      <h2 class="mt-8 font-heading text-xl font-semibold text-primary">{a.finalidades_titulo}</h2>
      <ul>
        {a.finalidades_primarias.map((item) => <li>{item}</li>)}
        {a.finalidades_secundarias.map((item) => <li>{item}</li>)}
      </ul>

      <h2 class="mt-8 font-heading text-xl font-semibold text-primary">{a.transferencias_titulo}</h2>
      <p>{a.transferencias_texto}</p>

      <h2 class="mt-8 font-heading text-xl font-semibold text-primary">{a.derechos_titulo}</h2>
      <p>{a.derechos_texto}</p>

      <h2 class="mt-8 font-heading text-xl font-semibold text-primary">{a.cambios_titulo}</h2>
      <p>{a.cambios_texto}</p>
    </div>
  </section>
</BaseLayout>
