---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContent, type Lang } from '../../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { niveles_educativos } = getContent(lang);
---

<BaseLayout lang={lang} path="/niveles-educativos" title={niveles_educativos.titulo}>
  <section class="section-padding">
    <div class="container-base">
      <h1 class="font-heading text-3xl font-bold text-primary text-center">{niveles_educativos.titulo}</h1>
      <p class="mt-2 text-lg text-neutral-600 text-center">{niveles_educativos.subtitulo}</p>
      <p class="mt-6 text-neutral-700 max-w-2xl mx-auto text-center">{niveles_educativos.intro}</p>

      <div class="mt-12 grid gap-8 max-w-2xl mx-auto">
        {niveles_educativos.niveles.map((nivel) => (
          <div class="rounded-2xl border border-neutral-200 p-6 md:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="font-heading text-2xl font-semibold text-primary">{nivel.nombre}</h2>
              <span class="text-sm text-neutral-500">{nivel.grados}</span>
            </div>
            <p class="mt-3 text-neutral-700">{nivel.descripcion}</p>

            <dl class="mt-6 grid grid-cols-3 gap-4 text-sm">
              <div>
                <dt class="text-neutral-500">{lang === 'es' ? 'Turno' : 'Shift'}</dt>
                <dd class="mt-1 font-medium text-neutral-800">{nivel.turno}</dd>
              </div>
              <div>
                <dt class="text-neutral-500">{lang === 'es' ? 'Tipo' : 'Type'}</dt>
                <dd class="mt-1 font-medium text-neutral-800">{nivel.tipo}</dd>
              </div>
              <div>
                <dt class="text-neutral-500">CCT</dt>
                <dd class="mt-1 font-medium text-neutral-800">{nivel.cct}</dd>
              </div>
            </dl>

            {nivel.distintivos.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {nivel.distintivos.map((d: string) => (
                  <li class="rounded-full bg-secondary px-3 py-1.5 text-sm font-medium text-primary">{d}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
